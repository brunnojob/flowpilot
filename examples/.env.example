TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=123456789
# Channel for rss-to-telegram (the bot must be an admin of the channel)
TELEGRAM_CHANNEL=@your_channel
# Shared secret for the contact-form webhook
CONTACT_WEBHOOK_SECRET=change-me
# Incoming Discord webhook URL (includes a secret; keep it in .env)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN
# GITHUB_TOKEN=ghp_...   # optional: raises GitHub API rate limits
# TELEGRAM_API_BASE=https://api.telegram.org
# HTTPS_PROXY=http://127.0.0.1:8118
